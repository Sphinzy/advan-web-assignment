                },
                {
                  "key": "categoryId",
                  "value": "1",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "/path/to/your/company-logo.jpg"
                }
              ]
            },
            "url": "{{baseUrl}}/api/jobs"
          }
        },
        {
          "name": "Update Job (with File Upload)",
          "request": {
            "method": "PUT",
            "header": [
