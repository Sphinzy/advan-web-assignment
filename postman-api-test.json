                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": "/path/to/your/new-logo.jpg"
                }
              ]
            },
            "url": "{{baseUrl}}/api/jobs/1"
          }
        },
        {
          "name": "Update Job (without File Upload)",
          "request": {
